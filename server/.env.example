PORT=5000
MONGO_URI=your_mongodb_connection_string

# JWT — replace with a long, random secret (e.g. generated with: openssl rand -hex 64)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

# Seat hold duration in minutes.
# Default: 5. Use 0.1 during local expiry tests only.
SEAT_HOLD_MINUTES=5
